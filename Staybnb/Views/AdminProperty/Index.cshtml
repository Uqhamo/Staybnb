@model IEnumerable<Staybnb.Models.PropertyApplication>

@{
    ViewData["Title"] = "Property Approvals";
}

<div class="container py-4">
    <h2>Property Approvals</h2>

    <p class="text-muted">
        Review property applications submitted by hosts.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            There are no pending property applications.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Property</th>
                        <th>Address</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var property in Model)
                    {
                        <tr>
                            <td>@property.Title</td>
                            <td>@property.Address</td>
                            <td>@property.Price</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    @property.Status
                                </span>
                            </td>
                            <td>
                                <form asp-action="Approve"
                                      asp-route-id="@property.Id"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        Approve
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
