@model List<Staybnb.Models.ViewModels.PendingApplicationViewModel>

@{
    ViewData["Title"] = "Pending Host Applications";
}

<div class="container py-4">
    <h2>Pending Host Applications</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            There are no pending applications.
        </div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Applicant</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model)
                {
                    <tr>
                        <td>@app.Email</td>
                        <td>
                            <form asp-controller="HostApplication"
                                  asp-action="ApproveApplication"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="ApplicationId"
                                       value="@app.ApplicationId" />

                                <button type="submit"
                                        class="btn btn-success btn-sm">
                                    Approve
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }