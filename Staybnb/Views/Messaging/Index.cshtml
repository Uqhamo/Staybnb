@model IEnumerable<Staybnb.Models.Message>

@{
    ViewData["Title"] = "Messages";
    var currentUserId = ViewBag.CurrentUserId as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Messages</h2>

        <a asp-controller="Messages"
           asp-action="Compose"
           class="btn btn-primary">
            New Message
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card p-4">
            <p class="mb-0">
                You have no messages yet.
            </p>
        </div>
    }
    else
    {
        @foreach (var message in Model)
        {
            var isReceived = message.ReceiverId == currentUserId;

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5>@message.Subject</h5>

                    <p class="text-muted mb-2">
                        @(isReceived ? "From another user" : "Sent by you")
                        · @message.SentAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    </p>

                    <p style="white-space: pre-wrap;">@message.Content</p>

                    @if (isReceived && !message.IsRead)
                    {
                        <span class="badge bg-primary">Unread</span>

                        <form asp-controller="Messages"
                              asp-action="MarkAsRead"
                              method="post"
                              class="mt-2">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@message.Id" />

                            <button type="submit"
                                    class="btn btn-sm btn-outline-primary">
                                Mark as Read
                            </button>
                        </form>
                    }
                    else if (isReceived)
                    {
                        <span class="badge bg-secondary">Read</span>
                    }
                </div>
            </div>
        }
    }
</div>
