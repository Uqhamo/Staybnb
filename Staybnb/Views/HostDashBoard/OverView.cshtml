@using Staybnb.Models

@{
    ViewData["Title"] = "Host Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Host Dashboard</h2>
            <p class="text-muted">
                Manage your properties and applications.
            </p>
        </div>

        <a asp-controller="Property"
           asp-action="BecomeAHost"
           class="btn btn-danger">
            + Add a Property
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (ViewBag.Properties == null ||
         ((IEnumerable<PropertyApplication>)ViewBag.Properties).Any() == false)
    {
        <div class="card shadow-sm p-4 text-center">
            <h4>No properties yet</h4>
            <p class="text-muted">
                Submit your first property to get started.
                Your application will need administrator approval.
            </p>

            <div>
                <a asp-controller="Property"
                   asp-action="BecomeAHost"
                   class="btn btn-danger">
                    Submit Your First Property
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var property in
                (IEnumerable<PropertyApplication>)ViewBag.Properties)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                @property.Title
                            </h5>

                            <p class="text-muted">
                                @property.Address
                            </p>

                            <p>
                                Status:
                                @if (property.Status == ApplicationStatus.Approved)
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending approval
                                    </span>
                                }
                            </p>

                            @if (property.Status == ApplicationStatus.Approved)
                            {
                                <a asp-controller="HostDashboard"
                                   asp-action="Index"
                                   asp-route-propertyId="@property.Id"
                                   class="btn btn-outline-danger">
                                    Manage Property
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Available after approval
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>