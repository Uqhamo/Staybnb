@{
    ViewData["Title"] = "Application Submitted";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 text-center p-4">
                <div class="card-body">

                    <div class="mb-4">
                        <div class="rounded-circle bg-success-subtle d-inline-flex
                            align-items-center justify-content-center"
                             style="width: 80px; height: 80px;">
                            <span class="text-success fs-1">&#10003;</span>
                        </div>
                    </div>

                    <h2 class="text-success mb-3">
                        Application Submitted!
                    </h2>

                    <p class="text-muted mb-4">
                        Your host application has been received.
                        An administrator will review it before you can
                        become a host.
                    </p>

                    <a asp-controller="GuestDashBoard"
                       asp-action="Index"
                       class="btn btn-primary">
                        Return to Dashboard
                    </a>

                    <p class="small text-muted mt-4 mb-0">
                        Thank you for choosing Staybnb!
                    </p>

                </div>
            </div>
        </div>
    </div>

</div>