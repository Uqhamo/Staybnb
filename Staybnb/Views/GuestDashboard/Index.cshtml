@{
    ViewData["Title"] = "Guest Dashboard";
}

<style>
    .stay-layout {
        display: flex;
        align-items: stretch;
        gap: 24px;
        margin: 20px 0;
    }

    .stay-sidebar {
        width: 230px;
        min-width: 230px;
        background: #172554;
        color: white;
        padding: 20px 12px;
        border-radius: 12px;
        align-self: stretch;
    }

        .stay-sidebar h4 {
            padding: 8px 12px 18px;
            margin: 0;
            font-weight: bold;
        }

        .stay-sidebar a {
            display: block;
            color: #dbeafe;
            text-decoration: none;
            padding: 11px 12px;
            margin-bottom: 5px;
            border-radius: 7px;
        }

            .stay-sidebar a:hover,
            .stay-sidebar a.active {
                background: #2563eb;
                color: white;
            }

    .stay-main {
        flex: 1;
        min-width: 0;
    }

    .stat-card {
        border: 0;
        border-radius: 12px;
        height: 100%;
    }

    .stat-number {
        font-size: 30px;
        font-weight: bold;
        color: #172554;
    }

    @@media (max-width: 768px) {
        .stay-layout {
            flex-direction: column;
        }

        .stay-sidebar {
            width: 100%;
            min-width: 0;
        }
    }
</style>

<div class="container-fluid">
    <div class="stay-layout">

        <aside class="stay-sidebar">
            <h4>Staybnb</h4>
            <hr />

            <a asp-controller="GuestDashBoard"
               asp-action="Index"
               class="active">Overview</a>

            <a asp-controller="Property"
               asp-action="Index">Find a Stay</a>

            <a asp-controller="GuestBookings"
               asp-action="Index">My Bookings</a>

            <a asp-controller="HostRegistration"
               asp-action="Index">Become a Host</a>

            <a asp-controller="Messaging"
               asp-action="Index">Messages</a>

            <a asp-controller="Notifications"
               asp-action="Index">Notifications</a>

            <hr />

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="/"
                  method="post">
                <button type="submit"
                        class="btn btn-link text-decoration-none w-100 text-start"
                        style="color:#fecaca;">
                    Logout
                </button>
            </form>
        </aside>

        <main class="stay-main">
            <div class="mb-4">
                <h2>Guest Overview</h2>
                <p class="text-muted">
                    Welcome to Staybnb! Manage your stays and booking requests.
                </p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="card shadow-sm stat-card">
                        <div class="card-body">
                            <p class="text-muted mb-1">Total Bookings</p>
                            <div class="stat-number">
                                @ViewBag.TotalBookings
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="card shadow-sm stat-card">
                        <div class="card-body">
                            <p class="text-muted mb-1">Pending</p>
                            <div class="stat-number">
                                @ViewBag.PendingBookings
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="card shadow-sm stat-card">
                        <div class="card-body">
                            <p class="text-muted mb-1">Approved</p>
                            <div class="stat-number">
                                @ViewBag.ApprovedBookings
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="card shadow-sm stat-card">
                        <div class="card-body">
                            <p class="text-muted mb-1">Rejected</p>
                            <div class="stat-number">
                                @ViewBag.RejectedBookings
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 p-4 mb-4">
                <h4>Find your next stay</h4>
                <p class="text-muted">
                    Explore available properties and choose accommodation
                    that suits your needs.
                </p>
                <div>
                    <a asp-controller="Property"
                       asp-action="Index"
                       class="btn btn-primary">
                        Browse Properties
                    </a>

                    <a asp-controller="GuestBookings"
                       asp-action="Index"
                       class="btn btn-outline-primary ms-2">
                        View My Bookings
                    </a>
                </div>
            </div>

            <div class="card shadow-sm border-0 p-4">
                <h4>Become a Host</h4>
                <p class="text-muted">
                    Have a property to rent? Apply to list it on Staybnb.
                </p>
                <a asp-controller="HostRegistration"
                   asp-action="Index"
                   class="btn btn-outline-danger">
                    Become a Host
                </a>
            </div>
        </main>
    </div>
</div>
