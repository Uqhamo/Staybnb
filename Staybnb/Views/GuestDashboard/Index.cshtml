@{
    ViewData["Title"] = "Guest Dashboard";
}

<style>
    .stay-layout {
        display: flex;
        align-items: flex-start;
        gap: 24px;
        margin: 20px 0;
    }

    .stay-sidebar {
        width: 220px;
        min-width: 220px;
        background: #172554;
        color: white;
        padding: 18px 12px;
        border-radius: 12px;
    }

        .stay-sidebar h4 {
            padding: 8px 12px 18px;
            margin: 0;
            font-weight: bold;
        }

        .stay-sidebar a {
            display: block;
            color: #dbeafe;
            text-decoration: none;
            padding: 10px 12px;
            margin-bottom: 4px;
            border-radius: 7px;
            font-size: 14px;
        }

            .stay-sidebar a:hover,
            .stay-sidebar a.active {
                background: #2563eb;
                color: white;
            }

    .stay-main {
        flex: 1;
        min-width: 0;
    }

    @@media (max-width: 768px) {
        .stay-layout {
            flex-direction: column;
        }

        .stay-sidebar {
            width: 100%;
        }
    }
</style>

<div class="stay-layout">

    <aside class="stay-sidebar">
        <h4>Staybnb</h4>

        <a asp-controller="GuestDashBoard" asp-action="Index"
           class="active">Dashboard</a>

        <a asp-controller="Property" asp-action="Index">
            Find a Stay
        </a>

        <a asp-controller="GuestBookings" asp-action="Index">
             My Bookings
        </a>

        <a asp-controller="HostRegistration" asp-action="Index">
            Become a Host
        </a>

        <a href="#messages">Messages</a>
        <a href="#notifications">Notifications</a>
        <a asp-controller="Login" asp-action="Index">👤 My Profile / Sign In</a>

        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="/"
              method="post">
            <button type="submit"
                    class="btn btn-link text-decoration-none w-100 text-start"
                    style="color:#fecaca; padding:10px 12px;">
                Logout
            </button>
        </form>
    </aside>

    <main class="stay-main">
        <h2 class="mb-2">Welcome to Staybnb!</h2>
        <p class="text-muted">
            Find your next stay or manage your reservations.
        </p>

        <div class="row g-4 mt-2">

            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5>Find a Place to Stay</h5>
                        <p class="text-muted">
                            Browse available houses and accommodation.
                        </p>
                        <a asp-controller="Property"
                           asp-action="Index"
                           class="btn btn-primary">
                            Browse Houses
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5>My Bookings</h5>
                        <p class="text-muted">
                            Check your booking requests and reservation status.
                        </p>
                        <a asp-controller="GuestBookings"
                           asp-action="Index"
                           class="btn btn-outline-primary">
                            View My Bookings
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5>Become a Host</h5>
                        <p class="text-muted">
                            Apply to list your property on Staybnb.
                        </p>
                        <a asp-controller="HostRegistration"
                           asp-action="Index"
                           class="btn btn-danger">
                            Become a Host
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <div id="messages" class="card shadow-sm p-3 mt-4">
            <h5>Messages</h5>
            <p class="text-muted mb-0">
                Your messages will appear here when messaging is connected.
            </p>
        </div>

        <div id="notifications" class="card shadow-sm p-3 mt-3">
            <h5>Notifications</h5>
            <p class="text-muted mb-0">
                Your notifications will appear here when connected.
            </p>
        </div>
    </main>

</div>