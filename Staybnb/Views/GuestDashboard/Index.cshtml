@{
    ViewData["Title"] = "Guest Dashboard";
}

<h2 class="mb-4">Welcome</h2>

<div class="card shadow-sm" style="max-width: 560px;">
    <div class="card-body">
        <h5 class="card-title">Have a space to share?</h5>
        <p class="card-text text-muted">Apply to become a host and start earning from your property.</p>
        <a asp-controller="BecomeHost" asp-action="Create" class="btn btn-danger">Become a Host</a>
    </div>
</div>
