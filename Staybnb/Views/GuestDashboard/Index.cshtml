@{
    ViewData["Title"] = "Guest Dashboard";
}

<h2 class="mb-4">Welcome to Staybnb!</h2>
<p class="text-muted">Find your next stay or manage your reservations.</p>

<div class="row g-4 mt-3">

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Find a Place to Stay</h5>
                <p class="text-muted">
                    Browse available houses and find accommodation.
                </p>
                <a asp-controller="Property"
                   asp-action="Index"
                   class="btn btn-primary">
                    Browse Houses
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">My Bookings</h5>
                <p class="text-muted">
                    View your booking requests and reservation status.
                </p>
                <a asp-controller="GuestBookings"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    View My Bookings
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Become a Host</h5>
                <p class="text-muted">
                    Apply to list your property on Staybnb.
                </p>
                <a asp-controller="HostRegistration"
                   asp-action="Index"
                   class="btn btn-danger">
                    Become a Host
                </a>
            </div>
        </div>
    </div>

</div>